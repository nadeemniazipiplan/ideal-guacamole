# Personal Life Dashboard - environment variable NAMES only. Never commit real secrets.
#
# The app is fully functional with no environment variables at all (local-first, IndexedDB).
# The variables below are only needed if you opt in to private cloud sync (Supabase).
#
# Public, non-secret client configuration (safe to ship to the browser):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Enables the Settings > Cloud sync panel. "false" (or unset) keeps the app 100% local.
VITE_ENABLE_CLOUD_SYNC=false
#
# SERVER-SIDE ONLY. Never prefix these with VITE_ and never expose them to the client.
SUPABASE_SERVICE_ROLE_KEY=
